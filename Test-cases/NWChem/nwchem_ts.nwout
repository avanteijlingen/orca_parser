 argument  1 = nwchem_ts.nw
  NWChem w/ OpenMP: maximum threads =    1



============================== echo of input deck ==============================
echo
start rxn1_ts
title "rxn1 beta-scission TS: wB97X-D3/def2-SVP SMD(benzene), doublet"

memory 8 gb
charge 0

geometry units angstroms noautosym noautoz
  C     -1.35199682     0.65954074     0.40150528
  C     -0.03317519     0.36850640    -0.28262103
  C      1.16761549     0.97591461     0.41088759
  C      0.18807341    -1.67439771     0.67859820
  O      0.03578150    -0.14028464    -1.37643409
  H     -2.13834458     0.04226339    -0.01720922
  H     -1.60108262     1.70829111     0.24588584
  H     -1.27728044     0.48266154     1.47202317
  H      1.14535380     0.76316737     1.47754746
  H      2.08494019     0.59245564    -0.02079431
  H      1.13573224     2.05675445     0.27920388
  H      0.17397336    -1.82121701     1.74140904
  H      1.12757654    -1.91643288     0.22656453
  H     -0.65715830    -2.09723211     0.17650622
end

basis spherical
  * library def2-SVP
end

dft
  xc wb97x        # if your NWChem build lacks wb97x, use: xc cam-b3lyp
  disp vdw 3      # Grimme D3 (NWChem has no D4)
  mult 2
  odft            # unrestricted for the radical
  grid fine
  iterations 200
end

cosmo
  do_cosmo_smd true
  solvent benzene
end

driver
  maxiter 60
  xyz rxn1_ts_traj   # writes rxn1_ts_traj-NNN.xyz every step
end

# Hessian first (freq), then the saddle search uses it via the run database.
task dft freq
task dft saddle
task dft freq
